# Gatherly - Environment Variables Configuration

# Google Gemini API Key for Live Server-Side AI Generation
# If omitted or left empty, Gatherly operates in high-fidelity deterministic Demo Mode
GEMINI_API_KEY=

# Model selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Node environment
NODE_ENV=production
